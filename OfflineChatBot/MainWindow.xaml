<views:ChromelessWindow x:Class="OfflineChatBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfflineChatBot"
        xmlns:vm="clr-namespace:OfflineChatBot.ViewModels"
        xmlns:views="clr-namespace:OfflineChatBot.Views"
        xmlns:behaviors="clr-namespace:OfflineChatBot.Behaviors"
        xmlns:converters="clr-namespace:OfflineChatBot.Converters"
        xmlns:helpers="clr-namespace:OfflineChatBot.Helpers"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="OfflineChatBot - Embedded Local AI" Height="740" Width="1120"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgPrimaryBrush}"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVisConverter"/>
        <converters:MessageSegmentsConverter x:Key="SegmentsConverter"/>
        <Style x:Key="AttachmentButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AttachmentButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AttachmentButtonBorder" Property="Background" Value="{StaticResource BgCardBrush}"/>
                                <Setter TargetName="AttachmentButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AttachmentMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource BgSidebarBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AttachmentMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource BgInputBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="{StaticResource BgSidebarBrush}" Panel.ZIndex="1000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title/Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <iconPacks:PackIconBootstrapIcons Kind="CpuFill" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="OfflineChatBot" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Window Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click">
                    <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="14" Height="14"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click">
                    <iconPacks:PackIconBootstrapIcons Kind="Square" Width="12" Height="12"/>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click">
                    <iconPacks:PackIconBootstrapIcons Kind="X" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Logo / Title -->
                <StackPanel Grid.Row="0" Margin="4,8,4,16">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="CpuFill" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="OfflineChatBot"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="100% Embedded C# AI"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="28,2,0,0"/>
                </StackPanel>

                <!-- New Chat Button -->
                <Button Grid.Row="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,14"
                        Command="{Binding CreateNewChatCommand}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconBootstrapIcons Kind="PlusLg" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="New Chat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <!-- Sessions List -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding CurrentSession}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,10"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                                                                                  Kind="ChatLeftText"
                                                                                  Width="13"
                                                                                  Height="13"
                                                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="0,0,8,0"/>

                                                <Grid Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVisConverter}}"/>
                                                    
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             Foreground="{StaticResource TextPrimaryBrush}"
                                                             Background="{StaticResource BgCardBrush}"
                                                             BorderBrush="{StaticResource AccentBrush}"
                                                             BorderThickness="0,0,0,1"
                                                             FontSize="13"
                                                             Padding="2,0"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}"
                                                             LostFocus="TitleTextBox_LostFocus"
                                                             KeyDown="TitleTextBox_KeyDown"
                                                             Loaded="TitleTextBox_Loaded"/>
                                                </Grid>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button x:Name="BtnRename"
                                                            ToolTip="Rename Chat"
                                                            Background="Transparent"
                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderThickness="0"
                                                            Margin="4,0,0,0"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.BeginRenameChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="11" Height="11"/>
                                                    </Button>

                                                    <Button ToolTip="Delete Chat"
                                                            Background="Transparent"
                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderThickness="0"
                                                            Margin="4,0,0,0"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <iconPacks:PackIconBootstrapIcons Kind="Trash3" Width="13" Height="13"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="BtnRename" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                                <Setter TargetName="BtnRename" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgCardBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2A2B3C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Model Selector Card at Sidebar Bottom -->
                <Border Grid.Row="3"
                        Background="{StaticResource BgCardBrush}"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <iconPacks:PackIconBootstrapIcons Kind="Cpu" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="AI Model:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <ComboBox ItemsSource="{Binding Models.DownloadedModels}"
                                  SelectedItem="{Binding Models.SelectedModel}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,8"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="11"
                                Command="{Binding OpenModelManagerCommand}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconBootstrapIcons Kind="Gear" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Model Manager..." VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== CHAT AREA ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid>
                    <TextBlock Text="{Binding CurrentSession.Title, FallbackValue='Chat'}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,5"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding Status.Cpu}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,5"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding Status.Memory}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,5"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding Status.Backend}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="12"
                                Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBootstrapIcons Kind="CpuFill" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Models.SelectedModel.Name, FallbackValue='No model selected'}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat Feed ScrollViewer & ItemsControl -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ChatScrollViewer"
                          Padding="28,20"
                          VerticalScrollBarVisibility="Auto"
                          behaviors:AutoScrollBehavior.ScrollToEnd="True">
                <ItemsControl ItemsSource="{Binding CurrentSession.Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- Message Bubble -->
                                <Border x:Name="MsgBorder"
                                        Padding="16,12"
                                        MaxWidth="720">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource UserBubbleBrush}"/>
                                                    <Setter Property="CornerRadius" Value="16,16,4,16"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                    <Setter Property="Background" Value="{StaticResource AssistantBubbleBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="CornerRadius" Value="16,16,16,4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <!-- Sender Header -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- Sender Icon -->
                                            <iconPacks:PackIconBootstrapIcons Width="12" Height="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <iconPacks:PackIconBootstrapIcons.Style>
                                                    <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Kind" Value="PersonFill"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                                <Setter Property="Kind" Value="CpuFill"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconBootstrapIcons.Style>
                                            </iconPacks:PackIconBootstrapIcons>

                                            <!-- Sender Name -->
                                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Text" Value="You"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                                <Setter Property="Text" Value="Local AI"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Thinking Indicator when AI is preparing response -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,4"
                                                    Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisConverter}}">
                                            <iconPacks:PackIconBootstrapIcons Kind="CpuFill" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Local AI is thinking"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="13"
                                                       FontStyle="Italic"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                                       FontSize="13"
                                                       FontStyle="Italic"
                                                       FontWeight="Bold"
                                                       Width="18">
                                                <TextBlock.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text" Duration="0:0:1.2">
                                                                    <DiscreteStringKeyFrame Value="." KeyTime="0:0:0"/>
                                                                    <DiscreteStringKeyFrame Value=".." KeyTime="0:0:0.4"/>
                                                                    <DiscreteStringKeyFrame Value="..." KeyTime="0:0:0.8"/>
                                                                </StringAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </TextBlock.Triggers>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Attached Image in Bubble -->
                                        <Image Source="{Binding AttachedImagePath}"
                                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVisConverter}}"
                                               MaxWidth="400" MaxHeight="300"
                                               Stretch="Uniform"
                                               Margin="0,0,0,8"
                                               HorizontalAlignment="Left"/>

                                        <!-- Message Content (Sequential Text and Code Segments) -->
                                        <ItemsControl ItemsSource="{Binding Content, Converter={StaticResource SegmentsConverter}}"
                                                      Visibility="{Binding IsThinking, Converter={StaticResource InvBoolToVisConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <!-- Text Segment with Rich Markdown Formatting -->
                                                        <TextBlock helpers:MarkdownHelper.MarkdownText="{Binding Text}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="14"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="22"
                                                                   Visibility="{Binding IsCode, Converter={StaticResource InvBoolToVisConverter}}"/>

                                                        <!-- Code Segment -->
                                                        <views:CodeBlockControl CodeLanguage="{Binding Language}"
                                                                                Code="{Binding Code}"
                                                                                Visibility="{Binding IsCode, Converter={StaticResource BoolToVisConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Status / Download Bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgCardBrush}"
                    Padding="14,8"
                    Visibility="{Binding Models.IsDownloading, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <TextBlock Text="{Binding Status.Message}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <ProgressBar Value="{Binding Models.DownloadProgress}"
                                 Maximum="100"
                                 Height="8"
                                 Width="220"
                                 HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Message Input Bar (Floating Modern Card) -->
            <Border Grid.Row="3"
                    Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14">
                <Border Background="{StaticResource BgInputBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Attached Image Preview -->
                        <Border Grid.Row="0" Grid.Column="1" Margin="14,10,14,0" 
                                Visibility="{Binding HasPendingImage, Converter={StaticResource BoolToVisConverter}}" 
                                HorizontalAlignment="Left" CornerRadius="8" Background="{StaticResource BgCardBrush}" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding PendingImagePath}" MaxHeight="60" MaxWidth="100" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Image attached" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Background="Transparent" BorderThickness="0" Command="{Binding RemoveAttachedImageCommand}" ToolTip="Remove image">
                                    <iconPacks:PackIconBootstrapIcons Kind="X" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="1" Grid.Column="0" 
                                Style="{StaticResource AttachmentButtonStyle}"
                                Margin="8,0,0,8" VerticalAlignment="Bottom"
                                Click="AttachmentMenuButton_Click"
                                ToolTip="Add attachment">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource AttachmentMenuStyle}"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Style="{StaticResource AttachmentMenuItemStyle}" IsEnabled="False">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconBootstrapIcons Kind="Paperclip" Width="16" Height="16" Margin="0,0,10,0"/>
                                                <TextBlock Text="Attach file" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource AttachmentMenuItemStyle}" Command="{Binding AttachImageCommand}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconBootstrapIcons Kind="Image" Width="16" Height="16" Margin="0,0,10,0"/>
                                                <TextBlock Text="Attach image" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <iconPacks:PackIconBootstrapIcons Kind="PlusLg" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>

                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 Padding="14,10"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="4,4,8,4" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SendMessageCommand}"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource InvBoolToVisConverter}}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Send" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <iconPacks:PackIconBootstrapIcons Kind="SendFill" Width="12" Height="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding StopGenerationCommand}"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisConverter}}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBootstrapIcons Kind="StopFill" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</views:ChromelessWindow>
