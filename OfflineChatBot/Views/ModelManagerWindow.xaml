<local:ChromelessWindow x:Class="OfflineChatBot.Views.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfflineChatBot.Views"
        xmlns:converters="clr-namespace:OfflineChatBot.Converters"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Model Manager - Download AI Models" Height="620" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVisConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="{StaticResource BgSidebarBrush}" Panel.ZIndex="1000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title/Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <iconPacks:PackIconBootstrapIcons Kind="Server" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Model Manager" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Window Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click">
                    <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="14" Height="14"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click">
                    <iconPacks:PackIconBootstrapIcons Kind="Square" Width="12" Height="12"/>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click">
                    <iconPacks:PackIconBootstrapIcons Kind="X" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Model Manager Hub"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="Download and manage local offline GGUF AI models directly inside your app."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,4,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox IsChecked="{Binding UseGpu}"
                                  Content="Use GPU acceleration"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  FontSize="13"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BackendDescription}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding DownloadAllModelsCommand}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBootstrapIcons Kind="Download" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Download All Suggested Models" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Models Cards Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AvailableModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Details -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                        <!-- Downloaded Badge -->
                                        <Border Background="#23352B"
                                                BorderBrush="#A6E3A1"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconBootstrapIcons Kind="CheckCircleFill" Width="11" Height="11" Foreground="#A6E3A1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Downloaded &amp; Ready"
                                                           Foreground="#A6E3A1"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Size: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding SizeFormatted}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,16,0"/>

                                        <TextBlock Text="File: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Progress Section when downloading -->
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding Download.IsActive, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Download.BytesFormatted}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding Download.SpeedFormatted}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <ProgressBar Value="{Binding Download.Progress}"
                                                     Maximum="100"
                                                     Height="8"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     Background="{StaticResource BgInputBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Action Button -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.DownloadModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsDownloaded, Converter={StaticResource InvBoolToVisConverter}}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconBootstrapIcons Kind="CloudDownload" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Download" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisConverter}}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Trash3" Width="13" Height="13" Foreground="#F38BA8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Delete" Foreground="#F38BA8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
        <local:DialogHost x:Name="Dialogs" Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</local:ChromelessWindow>
