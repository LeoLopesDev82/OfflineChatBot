<UserControl x:Class="OfflineChatBot.Views.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OfflineChatBot.Converters"
             x:Name="Host"
             Visibility="Collapsed"
             Panel.ZIndex="2000"
             Focusable="True"
             PreviewKeyDown="Host_PreviewKeyDown">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#B0000000">
        <Border MinWidth="360" MaxWidth="520"
                Padding="24"
                CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="CaptionText"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="MessageText"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,24"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton" Content="No" Tag="No"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            MinWidth="88" Margin="0,0,10,0"
                            Click="Answer_Click"/>

                    <Button x:Name="CancelButton" Content="Cancel" Tag="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            MinWidth="88" Margin="0,0,10,0"
                            Click="Answer_Click"/>

                    <Button x:Name="OkButton" Content="OK" Tag="OK"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="Collapsed"
                            MinWidth="88"
                            Click="Answer_Click"/>

                    <Button x:Name="YesButton" Content="Yes" Tag="Yes"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="Collapsed"
                            MinWidth="88"
                            Click="Answer_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
