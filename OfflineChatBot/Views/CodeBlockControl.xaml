<UserControl x:Class="OfflineChatBot.Views.CodeBlockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OfflineChatBot.Views"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             Margin="0,8">

    <Border Background="{StaticResource CodeBgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Code Block Header -->
            <Border Grid.Row="0"
                    Background="#181825"
                    CornerRadius="10,10,0,0"
                    Padding="14,8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="LanguageLabel"
                               Text="{Binding CodeLanguage, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='code'}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button x:Name="CopyButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Click="CopyButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Copy" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CopyButtonText" Text="Copy code" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Code Text Container -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="14">
                <TextBox x:Name="CodeTextBox"
                         Text="{Binding Code, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="13"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
