<Window x:Class="OfflineChatBot.Views.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" MinHeight="180" SizeToContent="Height" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    
    <Border Background="{StaticResource BgCardBrush}" 
            CornerRadius="12" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.4" Direction="270" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,12" Background="{StaticResource BgSidebarBrush}" CornerRadius="12,12,0,0">
                <TextBlock x:Name="TitleText" Text="Title" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15"/>
            </Border>
            
            <!-- Content -->
            <TextBlock x:Name="MessageText" Grid.Row="1" Text="Message body goes here." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" Margin="15,20"/>
            
            <!-- Footer (Buttons) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,10,15,15">
                <Button x:Name="BtnYes" Content="Yes" Style="{StaticResource PrimaryButtonStyle}" Width="80" Margin="0,0,10,0" Click="BtnYes_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnNo" Content="No" Style="{StaticResource SecondaryButtonStyle}" Width="80" Click="BtnNo_Click" Visibility="Collapsed"/>
                
                <Button x:Name="BtnOk" Content="OK" Style="{StaticResource PrimaryButtonStyle}" Width="80" Click="BtnOk_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="80" Margin="10,0,0,0" Click="BtnCancel_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
